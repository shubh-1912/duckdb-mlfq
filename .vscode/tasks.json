{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Build DuckDB (MLFQ)",
            "type": "shell",
            "command": "cmake --build build --config Release --target duckdb",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "2. Build Benchmark",
            "type": "shell",
            "command": "cmake --build mlfq_benchmark/build_win --config Release && cp build/src/Release/duckdb.dll mlfq_benchmark/build_win/Release/",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "dependsOn": "1. Build DuckDB (MLFQ)",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "3. Run MLFQ Benchmark (SF=10)",
            "type": "shell",
            "command": "./mlfq_bench.exe",
            "options": {
                "cwd": "${workspaceFolder}/mlfq_benchmark/build_win/Release"
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new",
                "clear": true
            }
        },
        {
            "label": "Build All + Run Benchmark",
            "type": "shell",
            "command": "cmake --build build --config Release --target duckdb && cp build/src/Release/duckdb.dll mlfq_benchmark/build_win/Release/ && cmake --build mlfq_benchmark/build_win --config Release && cd mlfq_benchmark/build_win/Release && ./mlfq_bench.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "new",
                "clear": true
            }
        }
    ]
}
